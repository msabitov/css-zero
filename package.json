{
    "name": "css-zero",
    "version": "1.0.0",
    "private": true,
    "description": "Monorepo: CSS-Zero - Reuse-sharpened CSS-in-TS",
    "license": "Apache-2.0",
    "type": "module",
    "packageManager": "pnpm@12.4.1",
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm --filter @css-zero/compiler test",
        "test:integration": "node scripts/check-demos.mjs",
        "dev": "pnpm -r run --parallel --watch build",
        "dev:svelte": "vite --config examples/vite-svelte/vite.config.ts examples/vite-svelte",
        "dev:react": "vite --config examples/vite-react/vite.config.ts examples/vite-react",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "publish:compiler": "pnpm --filter @css-zero/compiler publish",
        "publish:core": "pnpm --filter @css-zero/core publish",
        "publish:vite-plugin": "pnpm --filter @css-zero/vite-plugin publish",
        "publish:all": "pnpm build && pnpm publish:compiler && pnpm publish:core && pnpm publish:vite-plugin"
    },
    "devDependencies": {
        "@babel/parser": "^7.24.0",
        "@babel/traverse": "^7.24.0",
        "@babel/types": "^7.24.0",
        "@types/babel__traverse": "^7.28.0",
        "@types/node": "^26.0.0",
        "magic-string": "^0.30.0",
        "prettier": "^3.3.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0"
    }
}
