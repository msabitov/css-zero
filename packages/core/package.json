{
    "name": "@css-zero/core",
    "version": "1.0.1",
    "description": "CSS-Zero core package",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Marat Sabitov",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
