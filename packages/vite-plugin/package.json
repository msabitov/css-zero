{
    "name": "@css-zero/vite-plugin",
    "version": "1.0.2",
    "description": "CSS-Zero Vite plugin",
    "license": "Apache-2.0",
    "author": "Marat Sabitov",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
